generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SOLICITANTE
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
}

enum Status {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  FECHADO
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String
  role           Role      @default(SOLICITANTE)
  
  ticketsCreated Ticket[]  @relation("TicketAuthor")
  ticketsAssigned Ticket[] @relation("TicketAssignee")
  comments       Comment[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Ticket {
  id               String    @id @default(uuid())
  title            String
  description      String
  category         String    
  priority         Priority  @default(MEDIA)
  status           Status    @default(ABERTO)
  isAiClassified   Boolean   @default(false)

  authorId         String
  author           User      @relation("TicketAuthor", fields: [authorId], references: [id])
  
  assigneeId       String?
  assignee         User?     @relation("TicketAssignee", fields: [assigneeId], references: [id])

  comments         Comment[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Comment {
  id          String   @id @default(uuid())
  text        String
  
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  createdAt   DateTime @default(now())
}